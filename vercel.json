{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "git": { "deploymentEnabled": false },
  "regions": ["fra1"],
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,.git/**,.github/**,.agents/**,.venv/**,tests/**,evals/**,docs/**,scripts/**,migrations/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**}"
    }
  }
}
